<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {# importmap() emits inline <script> tags. Where a CSP is enforced they need
               the nonce, or the browser drops them as soon as any nonce is in play. #}
            {% set script_nonce = null %}
            {% guard function csp_nonce %}
                {% set script_nonce = csp_nonce('script') %}
            {% endguard %}
            {% block importmap %}{{ importmap('app', script_nonce ? {nonce: script_nonce} : {}) }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
